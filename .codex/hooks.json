{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"./.ai/guards/block-secret-dump.sh\""
          },
          {
            "type": "command",
            "command": "bash \"./.ai/guards/block-destructive-commands.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"./.ai/gates/prod-guard/gate.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"./.ai/guards/precompact-persist-state.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"./.ai/guards/sessionstart-context-digest.sh\""
          },
          {
            "type": "command",
            "command": "bash \"./.ai/guards/ensure-memory-link.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"./.ai/guards/stop-unfinished-work.sh\""
          }
        ]
      }
    ]
  }
}
