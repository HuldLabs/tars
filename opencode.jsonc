{
  "mcp": {
    "projects": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "-u",
        "node",
        "-e",
        "DB_HOST=host.docker.internal",
        "-w",
        "/workspace",
        "node",
        "tools/framework/secrets.mjs",
        "exec",
        "--",
        "bun",
        "--conditions=react-server",
        "tools/framework/host/projects-mcp.ts"
      ],
      "enabled": true,
      "environment": {
        "MSYS_NO_PATHCONV": "1"
      }
    }
  },
  "permission": {
    "bash": {
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "docker ps *": "allow",
      "docker logs *": "allow",
      "docker images *": "allow",
      "git *": "allow"
    }
  }
}
